cdef unsigned char[NPROBS] _CONTEXT_LETTERS = b"BEHIMS"

class Context(enum.IntEnum):
    """Indices of the structural contexts in the profile matrix.
    """
    B = 0
    E = 1
    H = 2
    I = 3
    M = 4
    S = 5


cdef class ProfileMatrix:
    """A matrix storing structural probabilities for each nucleotide.
    """

    cdef size_t     seq_n
    cdef Float*     mat
    cdef Py_ssize_t _shape[2]

    def __init__(self, size_t seq_n):
        self.seq_n = seq_n
        self._shape[0] = NPROBS
        self._shape[1] = seq_n

        cdef size_t mat_size = max(seq_n, 1) * NPROBS
        if self.mat != NULL:
            free(self.mat)
        self.mat = <Float*> calloc(mat_size, sizeof(Float))
        if self.mat is NULL:
            raise MemoryError("failed to allocate matrix data")

    def __dealloc__(self):
        free(self.mat)
        self.mat = NULL

    def __getbuffer__(self, Py_buffer* buffer, int flags):
        if flags & PyBUF_FORMAT:
            buffer.format = b"d" if sizeof(Float) == 8 else b"f"
        else:
            buffer.format = NULL
        buffer.buf = <void*> self.mat
        buffer.internal = NULL
        buffer.itemsize = sizeof(Float)
        buffer.len = NPROBS * self.seq_n * sizeof(Float)
        buffer.ndim = 2
        buffer.obj = self
        buffer.readonly = 1
        buffer.shape = self._shape
        buffer.suboffsets = NULL
        buffer.strides = NULL

    def __len__(self):
        return NPROBS

    def __getitem__(self, object index):
        cdef ssize_t index_
        cdef ssize_t i
        cdef ssize_t j

        if isinstance(index, tuple):
            i, j = index
            if i < 0:
                i += NPROBS
            if i < 0 or i >= NPROBS:
                raise IndexError(i)
            if j < 0:
                j += self.seq_n
            if j < 0 or j >= self.seq_n:
                raise IndexError(i, j)
            return self.mat[i * self.seq_n + j]
        elif isinstance(index, slice):
            raise TypeError(index)
        else:
            index_ = index
            if index_ < 0:
                index_ += <ssize_t> NPROBS
            if index_ < 0 or index_ >= NPROBS:
                raise IndexError(index)
            return self.vec[<size_t> index_]

    @property
    def shape(self):
        return tuple(self._shape)


cdef class ProfileVector:
    """A vector storing a probability vector for each nucleotide.
    """

    cdef Float*     vec
    cdef Py_ssize_t _shape[1]
    cdef object     _owner
    cdef bool       _owned

    def __init__(self, size_t seq_n):
        self.seq_n = seq_n
        self._shape[0] = seq_n

    def __dealloc__(self):
        if not self._owned:
            free(self.vec)
            self.vec = NULL

    def __len__(self):
        return self.seq_n

    def __getitem__(self, ssize_t index):
        cdef ssize_t index_ = index
        if index_ < 0:
            index_ += <ssize_t> self.seq_n
        if index_ < 0 or index_ >= self.seq_n:
            raise IndexError(index)
        return self.vec[<size_t> index_]

    def __getbuffer__(self, Py_buffer* buffer, int flags):
        if flags & PyBUF_FORMAT:
            buffer.format = b"d" if sizeof(Float) == 8 else b"f"
        else:
            buffer.format = NULL
        buffer.buf = <void*> self.vec
        buffer.internal = NULL
        buffer.itemsize = sizeof(Float)
        buffer.len = self.seq_n * sizeof(Float)
        buffer.ndim = 1
        buffer.obj = self
        buffer.readonly = 1
        buffer.shape = self._shape
        buffer.suboffsets = NULL
        buffer.strides = NULL

    @property
    def shape(self):
        return tuple(self._shape)


cdef class Profile:
    """A structural context profile generated by LinearCapR.

    Attributes:
        free_energy (`float`): The free energy for the whole molecule,
            expressed in kcal/mol.
        matrix (`~pylinearcapr.ProfileMatrix`): The per-nucleotide
            matrix which stores the probabilities for the six local
            structural contexts predicted by LinearCapR (:math:`S`,
            :math:`H`, :math:`B`, :math:`I`, :math:`M`, :math:`E`).

    """
    cdef readonly Float         free_energy
    cdef readonly ProfileMatrix matrix

    cpdef str consensus(self):
        """Compute a consensus of the local structural context.
        """
        cdef size_t    i
        cdef size_t    i_max
        cdef size_t    j
        cdef size_t    seq_n = self.matrix._shape[1]
        
        cdef unsigned char      c
        cdef unsigned char      mask
        cdef bytearray          text = bytearray(seq_n)
        cdef unsigned char[::1] view = text

        with nogil:
            for j in range(seq_n):
                i_max = 0
                for i in range(NPROBS):
                    if self.matrix.mat[i*seq_n + j] > self.matrix.mat[i_max*seq_n + j]:
                        i_max = i
                c = _CONTEXT_LETTERS[i_max]
                mask = 0b0100000 * (self.matrix.mat[i_max*seq_n + j] < 0.5)
                view[j] = c | mask

        return text.decode('ascii')


cdef dict _MODELS = {
    "turner2004": Model.Turner2004,
    "turner1999": Model.Turner1999,
}

cdef class StructuralProfiler:
    """The LinearCapR structural profiler.

    Attributes:
        beam_size (`int`): The beam size the structural profiler was
            initialized with.
        energy_model (`str`): The energy model the structural profiler
            was initialized with.

    Example:
        Profile a sequence with default parameters (beam size of 100, and
        Turner (2004) energy model)::

            >>> profiler = StructuralProfiler()
            >>> profile = profiler.profile("ACGCUGUCUGUACUUGUAUC")
            >>> profile.consensus()
            'EE'

    """

    cdef readonly int beam_size
    cdef readonly str energy_model

    def __init__(
        self,
        int beam_size = 100,
        str energy_model not None = "turner2004",
    ): 
        """Create a new structural profiler.

        Arguments:
            beam_size (`int`): The beam width used for pruning. The value
                offers a trade-off between accuracy and memory requirements.
            energy_model (`str`): The energy model to use. Should be one of
                ``turner2004`` (the default) or ``turner1999``.

        """
        self.beam_size = beam_size
        self.energy_model = energy_model

        if energy_model not in _MODELS:
            raise ValueError(f"invalid energy model: {energy_model!r}")

    cpdef Profile profile(self, str sequence):
        """Profile the given sequence.

        Arguments:
            sequence (`str`): A nucleotide sequence to process. Uracil and
                Thymine nucleobases are treated interchangeably.

        Returns:
            `~pylinearcapr.StructuralProfiler`: The per-nucleotide structural
                context profile for the input sequence.

        """
        assert sequence

        cdef size_t              i
        cdef string              s        = sequence.encode('ascii') # TODO: transparent extraction
        cdef size_t              seq_n    = s.size()
        cdef Profile             profile  = Profile.__new__(Profile)
        cdef unique_ptr[LinCapR] profiler = unique_ptr[LinCapR](new LinCapR(
            self.beam_size,
            _MODELS[self.energy_model],
        ))

        profile.matrix = ProfileMatrix(seq_n)

        if seq_n == 0:
            return profile

        with nogil:
            profiler.get().run(s)
            profile.free_energy = profiler.get().get_energy_ensemble()
            for i in range(NPROBS):
                memcpy(
                    &profile.matrix.mat[i * seq_n],
                    profiler.get().probs[i].data(),
                    seq_n * sizeof(Float)
                )
        return profile